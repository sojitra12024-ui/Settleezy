# Copy to .env (`sz init` does this). Never commit .env.

# Claude API (drafts + analysis): https://platform.claude.com -> API keys
ANTHROPIC_API_KEY=

# Outlook / Microsoft 365: Azure app registration (see README, step 3)
MS_CLIENT_ID=
MS_TENANT_ID=

# Calendly: Integrations -> API & Webhooks -> Personal access token
CALENDLY_TOKEN=

# Instagram Business: filled in for you by `sz auth instagram` (README step 6)
IG_ACCESS_TOKEN=
IG_USER_ID=
# Your Meta app (developers.facebook.com): used by `sz auth instagram` and to check token expiry
FB_APP_ID=
FB_APP_SECRET=

# ElevenLabs voice: elevenlabs.io -> Profile -> API keys
ELEVENLABS_API_KEY=
